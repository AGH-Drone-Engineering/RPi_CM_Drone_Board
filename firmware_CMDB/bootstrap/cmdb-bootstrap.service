[Unit]
Description=Fetch ESP-provided configuration via loracom and publish it as environment variables
After=dev-serial0.device
Wants=dev-serial0.device
Before=multi-user.target
StartLimitIntervalSec=120
StartLimitBurst=20

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/cmdb/bin/bootstrap.sh
TimeoutStartSec=30
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
