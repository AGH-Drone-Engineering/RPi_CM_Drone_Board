[Unit]
Description=Fetch ESP-provided configuration via loracom and publish it as environment variables
# ttyAMA3, not serial0 (the console UART): ordering against serial0 guarantees
# nothing about the device bootstrap.sh needs, and the service then starts
# before /dev/ttyAMA3 exists and restart-loops on -ENODEV.
After=dev-ttyAMA3.device
Wants=dev-ttyAMA3.device
Before=multi-user.target
StartLimitIntervalSec=120
StartLimitBurst=20

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/cmdb/bin/bootstrap.sh
TimeoutStartSec=30
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
